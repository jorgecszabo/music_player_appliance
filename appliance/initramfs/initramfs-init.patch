+# Panda appliance (SQUASHFS-ROOT.md in the panda repository). panda_root=<path> on
+# the kernel command line: the root is a read-only squashfs image at <path> on the
+# boot medium, with a tmpfs overlay for writes. The apkovl is unpacked on top as
+# usual; no packages are installed.
+panda_media() {
+	local m
+	for m in "$ROOT"/media/*; do
+		if [ -d "$m/slots" ]; then
+			echo "$m"
+			return 0
+		fi
+	done
+	return 1
+}
+
+# An OTA trial boot (panda-ota.py activate) of this slot: from now on any reboot goes
+# back to the confirmed slot. panda-ota.py left that boot config next to the live one
+# (*.armed); panda-ota-confirm makes this slot the default again once it is healthy.
+panda_arm_rollback() {
+	local m="$1" f armed=
+	[ -n "$KOPT_panda_slot" ] || return 0
+	grep -qx "trial=$KOPT_panda_slot" "$m"/slots/state 2>/dev/null || return 0
+	for f in "$m"/*.armed "$m"/boot/extlinux/*.armed "$m"/extlinux/*.armed; do
+		[ -f "$f" ] && armed="$armed $f"
+	done
+	[ -n "$armed" ] || return 0
+	ebegin "Trial boot of slot $KOPT_panda_slot: arming the rollback"
+	$MOCK mount -o remount,rw "$m" || { echo "can't write the boot medium" > "$ROOT"/dev/kmsg; return 0; }
+	for f in $armed; do
+		$MOCK mv -f "$f" "${f%.armed}"
+	done
+	sync
+	$MOCK mount -o remount,ro "$m"
+	eend 0
+}
+
+mount_panda_root() {
+	local m img
+	m=$(panda_media) && panda_arm_rollback "$m"
+	img="$m$KOPT_panda_root"
+	ebegin "Mounting root image $KOPT_panda_root"
+	if [ -z "$m" ] || ! [ -f "$img" ]; then
+		eend 1 "not found on the boot medium"
+	fi
+	$MOCK modprobe -a loop squashfs overlay 2> /dev/null
+	mkdir -p "$ROOT"/media/root-ro "$ROOT"/media/root-rw
+	$MOCK mount -t squashfs -o ro,loop "$img" "$ROOT"/media/root-ro \
+		|| eend 1 "can't mount the image"
+	$MOCK mount -t tmpfs -o "$rootflags" root-tmpfs "$ROOT"/media/root-rw \
+		|| eend 1 "can't mount the tmpfs"
+	mkdir -p "$ROOT"/media/root-rw/root "$ROOT"/media/root-rw/work
+	$MOCK mount -t overlay -o \
+		lowerdir="$ROOT"/media/root-ro,upperdir="$ROOT"/media/root-rw/root,workdir="$ROOT"/media/root-rw/work \
+		overlayfs "$sysroot"
+	eend $? "can't mount the overlay"
+}
