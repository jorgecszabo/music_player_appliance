#!/sbin/openrc-run
# Power-up order for a combo Wi-Fi/Bluetooth chip (board.conf BT_DRIVER_AFTER_WIFI).
#
# On the PandaBoard's WL1271, powering the Wi-Fi half up or down (WLAN_EN) while
# Bluetooth is running resets the chip under the BT firmware: Bluetooth stops
# answering, and only cutting the power brings it back. So: the BT driver is
# blacklisted from autoloading on the kernel command line (modprobe.blacklist=,
# from the board's mkimg profile; a modprobe.d file would come too late, udev loads
# the driver a few seconds into boot); this settles the Wi-Fi half first, and only then loads the BT
# driver. If the board has an onboard Wi-Fi interface, it is brought up and
# stays up for good (panda-wifi never takes it down). If the kernel has no
# driver for it, the chip's SDIO card is still powered by the MMC core, which
# may power it off again (runtime PM, MMC_CAP_POWER_OFF_CARD): pin its power on.
# If neither shows up after 20 s, BT loads anyway.

description="Power up the onboard Wi-Fi before Bluetooth (shared chip)"

depend() {
	need localmount
	after modules hwdrivers udev-settle
	before bluetooth panda-bt panda-wifi
}

onboard_wifi() {
	for n in /sys/class/net/*; do
		[ -e "$n/phy80211" ] || continue
		readlink -f "$n/device" | grep -q /usb && continue
		echo "${n##*/}"
		return 0
	done
	return 1
}

# The SDIO card (mmcN:0001) of a chip nobody drives: echo its power control on.
sdio_card() {
	for f in /sys/bus/sdio/devices/*; do
		[ -e "$f" ] || continue
		[ -e "$f/driver" ] && continue	# a driver owns it: it handles the power
		c=$(readlink -f "$f/..")
		[ -e "$c/power/control" ] && echo "$c" && return 0
	done
	return 1
}

# Locally administered MAC from another interface's (as panda-wifi does).
derived_mac() {
	m=$(cat /sys/class/net/"$1"/address 2>/dev/null) || return 1
	case "$m" in ""|00:00:00:00:00:00) return 1 ;; esac
	# shellcheck disable=SC2046  # word splitting is the point
	set -- $(echo "$m" | tr ':' ' ')
	printf '%02x:%s:%s:%s:%s:%02x\n' $(( (0x$1 | 0x02) & 0xfe )) "$2" "$3" "$4" "$5" $(( 0x$6 ^ 0x01 ))
}

start() {
	. /etc/panda/board.conf
	[ -n "${BT_DRIVER_AFTER_WIFI:-}" ] || return 0
	ebegin "Settling the onboard Wi-Fi half before Bluetooth"
	i=0; ifc=""; card=""
	while [ $i -lt 40 ]; do
		ifc=$(onboard_wifi) && break
		card=$(sdio_card) && break
		sleep 0.5; i=$((i + 1))
	done
	if [ -n "$card" ]; then
		echo on > "$card/power/control" || ewarn "couldn't pin $card on"
	elif [ -n "$ifc" ]; then
		if [ -n "${WIFI_MAC_FROM:-}" ] && mac=$(derived_mac "$WIFI_MAC_FROM"); then
			ip link set "$ifc" address "$mac" 2>/dev/null
		fi
		ip link set "$ifc" up || ewarn "$ifc didn't come up"
	else
		ewarn "no onboard Wi-Fi interface or SDIO card; loading Bluetooth anyway"
	fi
	modprobe "$BT_DRIVER_AFTER_WIFI"
	eend $?
}
