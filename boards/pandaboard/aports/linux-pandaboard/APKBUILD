# Maintainer: Jorge Szabo <jorgecszabo@gmail.com>
#
# Linux LTS kernel for the PandaBoard (OMAP4430) audio appliance.
#
# The kernel is cross-compiled natively on the x86_64 build host by
# scripts/cross-build-kernel.sh (Alpine's arm-none-eabi-gcc, ~10 min instead of
# ~2 h under qemu-user), into build/kernel-staging/<flavor>. This APKBUILD only
# packages those files. scripts/build-package.sh runs cross-build.sh first.
# Config: _defconfig + _fragment; DTBs: _dtbs (relative to arch/arm/boot/dts/).
# Layout follows main/linux-lts so update-kernel / mkimage / the modloop
# service work unchanged: release "<ver>-<pkgrel>-pandaboard",
# /boot/{vmlinuz,System.map,config}-pandaboard, /boot/dtbs-pandaboard/.
_flavor=pandaboard
pkgname=linux-$_flavor
pkgver=6.18.60
pkgrel=16
pkgdesc="Linux LTS kernel for the PandaBoard (OMAP4430)"
url="https://www.kernel.org"
arch="armv7"
license="GPL-2.0-only"
depends="initramfs-generator"
options="!strip !check !tracedeps"
# The fragment is listed so its checksum is recorded with the package.
source="pandaboard.config"
# Read by scripts/cross-build-kernel.sh (single-line values).
_defconfig=omap2plus_defconfig
_fragment=pandaboard.config
_dtbs="ti/omap/omap4-panda*.dtb"
# Out-of-tree modules: the generic ones (DEFAULT_EXTMODS in
# scripts/cross-build-kernel.sh, e.g. r92su) are built for every board kernel.
# _extmods adds more, _extmods_skip leaves defaults out.
# The staged config must have this (catches a wrong or stale staging dir).
# Required options (grep -xE patterns): the SoC, and USB audio (the appliance's
# alternative output, audio-route.py).
_kconfig_check="CONFIG_ARCH_OMAP4=y CONFIG_SND_USB_AUDIO=[ym]"
_staging="${PANDA_KERNEL_STAGING:-/work/build/kernel-staging/$_flavor}"

package() {
	local _rel="$pkgver-$pkgrel-$_flavor"
	[ -f "$_staging"/usr/share/kernel/$_flavor/kernel.release ] \
		|| die "no staged kernel in $_staging (run cross-build.sh)"
	[ "$(cat "$_staging"/usr/share/kernel/$_flavor/kernel.release)" = "$_rel" ] \
		|| die "staged kernel is not $_rel"
	local _c
	for _c in $_kconfig_check; do
		grep -qxE "$_c" "$_staging"/boot/config-$_flavor \
			|| die "staged config lacks $_c"
	done

	mkdir -p "$pkgdir"
	cp -a "$_staging"/. "$pkgdir"/
}

sha512sums="
220bb833c9806e259f2ffff20f2ffc0943abb7162fc4a2371645284504de404a272285bfae068d549fca8f0326f5d1b91da6f5d9e032ab932401e1d446bf9451  pandaboard.config
"
