# BeagleBoard-xM (DM3730, OMAP3630 family) audio appliance: fragment merged on
# top of omap2plus_defconfig with scripts/kconfig/merge_config.sh. Derived from
# boards/pandaboard/aports/linux-pandaboard/pandaboard.config; the differences
# are the SoC, audio (TWL4030 on McBSP2) and no onboard radios.

# --- SoC: OMAP3 only (DM3730 = OMAP36xx, under SOC_OMAP3430) -----------------
# CONFIG_ARCH_OMAP2 is not set
CONFIG_ARCH_OMAP3=y
CONFIG_SOC_OMAP3430=y
# CONFIG_SOC_TI81XX is not set
# CONFIG_ARCH_OMAP4 is not set
# CONFIG_SOC_OMAP5 is not set
# CONFIG_SOC_AM33XX is not set
# CONFIG_SOC_AM43XX is not set
# CONFIG_SOC_DRA7XX is not set
CONFIG_LOCALVERSION="-beaglexm"
# CONFIG_LOCALVERSION_AUTO is not set
# gzip: fast to decompress, no extra host tools (omap2plus uses LZMA)
CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_LZMA is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Boot path built in (no initramfs module juggling) -----------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_OMAP_HS=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OMAP=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_OMAP=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BLK_DEV_INITRD=y

# --- Alpine diskless: modloop (squashfs over loop) + overlay ------------------
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_OVERLAY_FS=m
CONFIG_EXT4_FS=y

# --- Ethernet: LAN9514 hub + SMSC95xx on EHCI port 2 -------------------------
# (U-Boot sets usbethaddr from the die ID; the DT's ethernet alias carries it.)
CONFIG_USB=y
# No OTG/gadget on the appliance; also lets NOP_USB_XCEIV be built in.
# CONFIG_USB_GADGET is not set
# CONFIG_USB_MUSB_HDRC is not set
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_OMAP=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_IPV6=y
CONFIG_IP_MULTICAST=y

# --- Firewall (restrict network audio ports to the LAN) ----------------------
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_REJECT=m

# --- Wi-Fi: USB adapters only (no onboard radio) --------------------------------
# USB: the drivers a desktop distribution (Fedora, Ubuntu) ships, so any common
# dongle works. All modules; the modloop gets their firmware via modinfo, and
# regulatory.db (wireless-regdb) because cfg80211 is a module.
CONFIG_RFKILL=m
CONFIG_CFG80211=m
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_MAC80211=m
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_LEDS=y
CONFIG_WLAN=y
# CONFIG_WLAN_VENDOR_TI is not set
# Atheros/Qualcomm
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_AR5523=m
CONFIG_ATH6KL=m
CONFIG_ATH6KL_USB=m
CONFIG_ATH10K=m
CONFIG_ATH10K_USB=m
# Atmel
CONFIG_WLAN_VENDOR_ATMEL=y
CONFIG_AT76C50X_USB=m
# Broadcom
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_USB=y
# Intersil (Prism54 USB)
CONFIG_WLAN_VENDOR_INTERSIL=y
CONFIG_P54_COMMON=m
CONFIG_P54_USB=m
# Marvell
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_LIBERTAS=m
CONFIG_LIBERTAS_USB=m
CONFIG_LIBERTAS_THINFIRM=m
CONFIG_LIBERTAS_THINFIRM_USB=m
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_USB=m
# MediaTek (mt76: MT7601U, MT7610U/MT7612U, MT7663U, MT7921AU, MT7925U)
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7663U=m
CONFIG_MT7921U=m
CONFIG_MT7925U=m
# Ralink
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
# Realtek
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=m
CONFIG_RTL_CARDS=m
CONFIG_RTL8192CU=m
CONFIG_RTL8192DU=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTW88=m
CONFIG_RTW88_8723DU=m
CONFIG_RTW88_8812AU=m
CONFIG_RTW88_8814AU=m
CONFIG_RTW88_8821AU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BU=m
CONFIG_RTW89_8852BU=m
# Redpine
CONFIG_WLAN_VENDOR_RSI=y
CONFIG_RSI_91X=m
CONFIG_RSI_USB=m
# ZyDAS
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_ZD1211RW=m
# Not USB/SDIO here (PCIe-only vendors etc.)
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFE is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_CISCO is not set
# CONFIG_ATH9K is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH12K is not set
# CONFIG_ATH5K is not set
# CONFIG_ATH10K_PCI is not set
# CONFIG_ATH10K_SDIO is not set
# CONFIG_B43 is not set
# CONFIG_B43LEGACY is not set
# CONFIG_BRCMSMAC is not set
# CONFIG_BRCMFMAC_PCIE is not set

# --- Not needed on the appliance (also shortens the build) --------------------
# DSP/IPU co-processors: no firmware available
# CONFIG_REMOTEPROC is not set
# No keypad, camera/TV/IR, or NAND on the xM; no display (DVI/S-Video unused);
# no USB OTG (the TWL4030 PHY only serves the OTG port)
# CONFIG_KEYBOARD_TWL4030 is not set
# CONFIG_DRM_OMAP is not set
# CONFIG_TWL4030_USB is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RC_CORE is not set
# CONFIG_MTD is not set

# --- Audio -------------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_HRTIMER=m
# TWL4030 (TPS65950) codec on McBSP2: card "omap3beagle"
CONFIG_SND_SOC_TI_SDMA_PCM=m
CONFIG_SND_SOC_OMAP_MCBSP=m
CONFIG_SND_SOC_OMAP3_TWL4030=m
CONFIG_SND_SOC_TWL4030=m
CONFIG_MFD_TWL4030_AUDIO=y
# CONFIG_SND_SOC_OMAP3_PANDORA is not set
# CONFIG_SND_SOC_OMAP_MCPDM is not set
# CONFIG_SND_SOC_OMAP_ABE_TWL6040 is not set
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m
CONFIG_HIGH_RES_TIMERS=y

# --- Bluetooth: USB dongles only ----------------------------------------------
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
# CONFIG_BT_HCIUART is not set
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_UHID=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_ECB=y
CONFIG_KEY_DH_OPERATIONS=y

# --- Hotplug: Alpine's mdev service registers itself as the uevent helper ------
# (/proc/sys/kernel/hotplug). omap2plus leaves it off, so devices that appear
# after boot (the late-probing sound card, USB DAC/BT dongles) kept root-only
# permissions.
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""

# --- Entropy: the OMAP hardware RNG must be built in -------------------------
# As on the Panda: no fast cycle counter (jitter entropy uses the 32 kHz clock),
# so without omap_rng early, getrandom() blocks for minutes and the first boot
# hangs. The DM3730 GP has the same RNG block (ti,omap2-rng, enabled in the DT).
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_OMAP=y

# --- Power / reliability -----------------------------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_WATCHDOG=y
CONFIG_OMAP_WATCHDOG=y
# timeout/state in /sys/class/watchdog/ (for the web page).
CONFIG_WATCHDOG_SYSFS=y
# A CPU stuck in the kernel (still scheduling elsewhere, so busybox watchdog
# keeps petting) panics -> kernel.panic reboots. No hard-lockup detector on
# ARM32 (no NMI); the hardware watchdog covers full freezes.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
# Report (don't panic on) tasks stuck in D state for 120 s.
CONFIG_DETECT_HUNG_TASK=y
# No battery: the DT's HDQ/1-Wire node made the bq27000 gauge driver probe for a
# battery that isn't there (phantom power_supply + LED triggers).
# CONFIG_W1 is not set
# CONFIG_HDQ_MASTER_OMAP is not set
# CONFIG_BATTERY_BQ27XXX is not set
CONFIG_RTC_DRV_TWL4030=y
# DM3730 bandgap sensor: thermal zone "cpu-thermal"
CONFIG_TI_SOC_THERMAL=y
CONFIG_TI_THERMAL=y
CONFIG_OMAP3_THERMAL=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# --- Firmware: Alpine ships linux-firmware zstd-compressed --------------------
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
