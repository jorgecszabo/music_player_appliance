# The appliance's packages: panda-appliance depends on all of them, so they go
# into every slot's root image (scripts/build-rootfs.sh). One or more per line;
# # starts a comment.
alpine-base apk-cron busybox doas openssl tzdata wget
chrony
openssh
avahi dbus
e2fsprogs dosfstools
# setup-devd udev (PipeWire needs udevd)
eudev udev-init-scripts udev-init-scripts-openrc
# Audio
alsa-utils pipewire pipewire-alsa pipewire-tools wireplumber
pipewire-filter-graph pipewire-filter-graph-builtin pipewire-pulse
pipewire-spa-bluez
# AirPlay (our aports build with the native PipeWire backend wins by version)
shairport-sync shairport-sync-openrc
# Bluetooth
bluez bluez-deprecated
# Appliance services (python3: panda-bt, panda-web, panda-arbiter)
python3 py3-evdev py3-dbus-next
nftables
# Wi-Fi (panda-wifi)
wpa_supplicant iw
mpv
