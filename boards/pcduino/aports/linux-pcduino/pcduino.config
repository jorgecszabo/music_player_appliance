# pcDuino Lite (Allwinner A10) audio appliance: fragment merged on top of
# omap2plus_defconfig with scripts/kconfig/merge_config.sh.
#
# Why omap2plus and not sunxi_defconfig: the kernel is multiplatform, and
# omap2plus is the generic baseline (namespaces, cgroups, SYSVIPC, netfilter,
# security modules, ...) that the appliance runs on, verified on the Panda and
# the xM. sunxi_defconfig lacks ~1100 of those options. So this fragment swaps
# the platform: all OMAP SoCs off, the A10 on, plus the A10's drivers. The
# generic sections (modloop, firewall, Wi-Fi, Bluetooth, hotplug) are the xM's.

# --- SoC: Allwinner A10 only (sun4i) -----------------------------------------
# CONFIG_ARCH_OMAP2 is not set
# CONFIG_ARCH_OMAP3 is not set
# CONFIG_ARCH_OMAP4 is not set
# CONFIG_SOC_OMAP5 is not set
# CONFIG_SOC_AM33XX is not set
# CONFIG_SOC_AM43XX is not set
# CONFIG_SOC_DRA7XX is not set
CONFIG_ARCH_SUNXI=y
CONFIG_MACH_SUN4I=y
# CONFIG_MACH_SUN5I is not set
# CONFIG_MACH_SUN6I is not set
# CONFIG_MACH_SUN7I is not set
# CONFIG_MACH_SUN8I is not set
# CONFIG_MACH_SUN9I is not set
CONFIG_LOCALVERSION="-pcduino"
# CONFIG_LOCALVERSION_AUTO is not set
# gzip: fast to decompress, no extra host tools (omap2plus uses LZMA)
CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_LZMA is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Boot path built in (no initramfs module juggling) -----------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y
# UART0 (ttyS0): DesignWare 8250
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
# The AXP209 PMIC on I2C0 (CPU and SDRAM rails, the CPU's cpufreq supply).
CONFIG_I2C=y
CONFIG_I2C_MV64XXX=y
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_DMADEVICES=y
CONFIG_DMA_SUN4I=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BLK_DEV_INITRD=y

# --- Alpine diskless: modloop (squashfs over loop) + overlay ------------------
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_OVERLAY_FS=m
CONFIG_EXT4_FS=y

# --- Ethernet: A10 EMAC (10/100, PHY at MDIO address 1) ----------------------
# (U-Boot derives the MAC address from the SID and puts it in the DT.)
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_ALLWINNER=y
CONFIG_SUN4I_EMAC=y
CONFIG_IPV6=y
CONFIG_IP_MULTICAST=y

# --- USB: 2 host ports (EHCI/OHCI) + the OTG port as a third host (MUSB) ------
# The OTG port in dual-role mode: an OTG adapter grounds the ID pin (PH4) and
# makes it a host. Host-only MUSB would be enough, but the pcDuino DT says
# dr_mode = "otg", which a host-only build rejects (musb-sunxi: probe -22, seen
# in QEMU). Dual role needs the gadget core; no gadget functions are built.
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_EXTCON=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_GADGET=y

# --- Firewall (restrict network audio ports to the LAN) ----------------------
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_REJECT=m

# --- Wi-Fi: USB adapters only (no onboard radio) --------------------------------
# USB: the drivers a desktop distribution (Fedora, Ubuntu) ships, so any common
# dongle works. All modules; the modloop gets their firmware via modinfo, and
# regulatory.db (wireless-regdb) because cfg80211 is a module.
CONFIG_RFKILL=m
CONFIG_CFG80211=m
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_MAC80211=m
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_LEDS=y
CONFIG_WLAN=y
# CONFIG_WLAN_VENDOR_TI is not set
# Atheros/Qualcomm
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_AR5523=m
CONFIG_ATH6KL=m
CONFIG_ATH6KL_USB=m
CONFIG_ATH10K=m
CONFIG_ATH10K_USB=m
# Atmel
CONFIG_WLAN_VENDOR_ATMEL=y
CONFIG_AT76C50X_USB=m
# Broadcom
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_USB=y
# Intersil (Prism54 USB)
CONFIG_WLAN_VENDOR_INTERSIL=y
CONFIG_P54_COMMON=m
CONFIG_P54_USB=m
# Marvell
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_LIBERTAS=m
CONFIG_LIBERTAS_USB=m
CONFIG_LIBERTAS_THINFIRM=m
CONFIG_LIBERTAS_THINFIRM_USB=m
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_USB=m
# MediaTek (mt76: MT7601U, MT7610U/MT7612U, MT7663U, MT7921AU, MT7925U)
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7663U=m
CONFIG_MT7921U=m
CONFIG_MT7925U=m
# Ralink
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
# Realtek
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=m
CONFIG_RTL_CARDS=m
CONFIG_RTL8192CU=m
CONFIG_RTL8192DU=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTW88=m
CONFIG_RTW88_8723DU=m
CONFIG_RTW88_8812AU=m
CONFIG_RTW88_8814AU=m
CONFIG_RTW88_8821AU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BU=m
CONFIG_RTW89_8852BU=m
# Redpine
CONFIG_WLAN_VENDOR_RSI=y
CONFIG_RSI_91X=m
CONFIG_RSI_USB=m
# ZyDAS
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_ZD1211RW=m
# Not USB/SDIO here (PCIe-only vendors etc.)
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFE is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_CISCO is not set
# CONFIG_ATH9K is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH12K is not set
# CONFIG_ATH5K is not set
# CONFIG_ATH10K_PCI is not set
# CONFIG_ATH10K_SDIO is not set
# CONFIG_B43 is not set
# CONFIG_B43LEGACY is not set
# CONFIG_BRCMSMAC is not set
# CONFIG_BRCMFMAC_PCIE is not set


# --- Not needed on the appliance (also shortens the build) --------------------
# HDMI boot console (the only console without a 3.3 V serial adapter): U-Boot
# drives HDMI and passes its framebuffer as a simple-framebuffer node, so
# simplefb + fbcon show the kernel and OpenRC messages on a monitor. No monitor:
# no node, nothing changes. (VT, FB and FRAMEBUFFER_CONSOLE come from omap2plus.)
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# No display driver otherwise (mainline's A10 HDMI has no audio), camera, IR,
# NAND or SATA on the Lite.
# CONFIG_DRM is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RC_CORE is not set
# CONFIG_MTD is not set
# CONFIG_ATA is not set

# --- Audio: USB only ----------------------------------------------------------
# The A10 codec's outputs aren't wired out on the pcDuino (no jack).
CONFIG_SOUND=y
CONFIG_SND=y
# CONFIG_SND_SOC is not set
CONFIG_SND_HRTIMER=m
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m
CONFIG_HIGH_RES_TIMERS=y

# --- Bluetooth: USB dongles only ----------------------------------------------
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
# CONFIG_BT_HCIUART is not set
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_UHID=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_ECB=y
CONFIG_KEY_DH_OPERATIONS=y

# --- Hotplug: Alpine's mdev service registers itself as the uevent helper ------
# (/proc/sys/kernel/hotplug). omap2plus leaves it off, so devices that appear
# after boot (the late-probing sound card, USB DAC/BT dongles) kept root-only
# permissions.
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""

# --- Entropy: no hardware RNG on the A10 ----------------------------------------
# (The Security System's PRNG is a crypto API rng, not a hwrng.) Unlike the
# OMAPs, jitter entropy has a fast clock: ARM32 has no cycle counter here, so
# random_get_entropy() falls back to the clocksource, the 24 MHz sun4i timer
# (the OMAPs' was 32 kHz). Unverified on the board: check how long the crng
# takes to initialize (dmesg "crng init done").

# --- Power / reliability -----------------------------------------------------
# cpufreq: the DT's OPPs up to 1 GHz on the AXP209's DCDC2.
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y
# timeout/state in /sys/class/watchdog/ (for the web page).
CONFIG_WATCHDOG_SYSFS=y
# A CPU stuck in the kernel (still scheduling elsewhere, so busybox watchdog
# keeps petting) panics -> kernel.panic reboots. No hard-lockup detector on
# ARM32 (no NMI); the hardware watchdog covers full freezes.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
# Report (don't panic on) tasks stuck in D state for 120 s.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_RTC_DRV_SUNXI=y
# A10 temperature sensor in the touchscreen controller: thermal zone
# "cpu-thermal" (sun4i-a10.dtsi). The touchscreen part stays unused. A module
# (it needs HWMON, a module in omap2plus); the zone appears when it loads.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SUN4I=m
# TX/RX LEDs and the (unverified) Back/Home/Menu keys.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_KEYBOARD_GPIO=y
# The SID (MAC address source, read by U-Boot; harmless in Linux).
CONFIG_NVMEM_SUNXI_SID=y

# --- Firmware: Alpine ships linux-firmware zstd-compressed --------------------
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
