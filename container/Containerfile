# Native armv7 Alpine build environment (runs under qemu-user binfmt on x86_64).
# Used for abuild packaging (kernel, U-Boot, userland ports) and mkimage.
ARG ALPINE_VERSION=3.24
FROM --platform=linux/arm/v7 docker.io/library/alpine:${ALPINE_VERSION}

RUN apk add --no-cache \
        alpine-sdk alpine-conf abuild-rootbld \
        bash bc bison flex dtc elfutils-dev findutils gmp-dev \
        linux-headers mpc1-dev mpfr-dev ncurses-dev openssl-dev perl \
        python3 py3-setuptools py3-elftools swig gnutls-dev util-linux-dev \
        xz lz4 zstd squashfs-tools mtools dosfstools sudo \
        tar git rsync

# Build user matching the host uid so bind-mounted files stay owned by us.
ARG UID=1000
ARG GID=1000
RUN addgroup -g ${GID} builder \
 && adduser -D -u ${UID} -G builder -s /bin/bash builder \
 && addgroup builder abuild \
 && echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder

USER builder
WORKDIR /work
