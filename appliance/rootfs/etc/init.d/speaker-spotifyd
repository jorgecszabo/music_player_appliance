#!/sbin/openrc-run
# Spotify Connect receiver (spotifyd) as user "speaker", playing into the
# system-wide PipeWire. Config: /etc/spotifyd.conf (generated by
# /etc/panda/setup.sh). Credentials come from the phone through zeroconf each
# time; the cache is in RAM, so nothing is stored on the boot media.

description="Spotify Connect receiver (spotifyd, user speaker)"
supervisor=supervise-daemon
command=/usr/bin/spotifyd
command_args="--no-daemon --config-path /etc/spotifyd.conf"
command_user="speaker:speaker"
directory=/var/lib/speaker
output_log=/var/log/speaker/spotifyd.log
error_log=/var/log/speaker/spotifyd.log
respawn_delay=5
respawn_max=0
supervise_daemon_args="--env XDG_RUNTIME_DIR=/run/speaker --env PIPEWIRE_RUNTIME_DIR=/run/speaker --env HOME=/var/lib/speaker"

depend() {
	need net speaker-wireplumber
	after avahi-daemon
}

start_pre() {
	checkpath --directory --owner speaker:speaker --mode 0750 /var/lib/speaker/spotifyd-cache
}
