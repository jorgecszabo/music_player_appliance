# Local fork of Alpine's community/mpv (3.24) for the appliance: a headless
# audio player for speaker-radio. Alpine's mpv links X11, Wayland, Vulkan, EGL,
# VA-API, ... and pulls in mesa + llvm (~170 MB), which the diskless appliance
# holds in RAM. Changes: every optional feature off (including gl, which is
# on by default) except the PipeWire audio output, zlib and iconv; no Lua, no
# libmpv, no man pages; no check (slow under qemu-user). libplacebo and
# libass are mandatory in mpv 0.41 (they don't need a GPU). pkgrel 100 so it
# wins over Alpine's package of this version; setup.sh puts !mesa in the world
# so a newer Alpine mpv can't bring it back.
# Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Contributor: Łukasz Jendrysik <scadu@yandex.com>
# Contributor: Jakub Skrzypnik <j.skrzypnik@openmailbox.org>
# Maintainer: Alex McGrath <amk@amk.ie>
pkgname=mpv
pkgver=0.41.0
pkgrel=100
# Alpine package this fork is based on (scripts/check-forks.sh compares it
# with Alpine's current one): repository/name and version-release.
_upstream=community/mpv
_upstream_base=0.41.0-r2
pkgdesc="Video player based on MPlayer/mplayer2 (headless audio build)"
url="https://mpv.io/"
license="GPL-2.0-or-later"
arch="all"
makedepends="
	ffmpeg-dev
	libass-dev
	libplacebo-dev
	meson
	pipewire-dev
	zlib-dev
	"
subpackages="$pkgname-doc"
source="https://github.com/mpv-player/mpv/archive/v$pkgver/mpv-v$pkgver.tar.gz
	meson-libcaca-version.patch
	"
options="!check"

prepare() {
	default_prepare

	echo "$pkgver" > VERSION
}

build() {
	# abuild-meson hardcodes --auto-features=auto, and meson refuses a second
	# value, so this is its command line with --auto-features=disabled.
	CFLAGS="$CFLAGS -O2" \
	CXXFLAGS="$CXXFLAGS -O2" \
	meson setup \
		--prefix=/usr \
		--libdir=/usr/lib \
		--libexecdir=/usr/libexec \
		--bindir=/usr/bin \
		--sbindir=/usr/sbin \
		--includedir=/usr/include \
		--datadir=/usr/share \
		--mandir=/usr/share/man \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=plain \
		--auto-features=disabled \
		--wrap-mode=nodownload \
		-Db_lto=false \
		-Db_pie=true \
		-Dwerror=false \
		-Dbuild-date=false \
		-Dcplayer=true \
		-Dgl=disabled \
		-Dlibmpv=false \
		-Dlua=disabled \
		-Dmanpage-build=disabled \
		-Diconv=enabled \
		-Dpipewire=enabled \
		-Dzlib=enabled \
		-Dtests=false \
		. output

	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm644 "$builddir"/DOCS/*.rst "$builddir"/DOCS/*.md \
		-t "$pkgdir"/usr/share/doc/$pkgname/

	# Move example configuration files to subdirectory
	mkdir -p "$pkgdir"/usr/share/doc/mpv/examples
	mv "$pkgdir"/usr/share/doc/mpv/*.conf \
		"$pkgdir"/usr/share/doc/mpv/examples/
	# Desktop files and icons: no desktop here.
	rm -rf "$pkgdir"/usr/share/applications "$pkgdir"/usr/share/icons \
		"$pkgdir"/usr/share/metainfo
}

