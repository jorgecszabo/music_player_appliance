# PandaBoard (OMAP4430) audio appliance: fragment merged on top of
# omap2plus_defconfig with scripts/kconfig/merge_config.sh.

# --- SoC: OMAP4 only ---------------------------------------------------------
# CONFIG_ARCH_OMAP2 is not set
# CONFIG_ARCH_OMAP3 is not set
CONFIG_ARCH_OMAP4=y
# CONFIG_SOC_OMAP5 is not set
# CONFIG_SOC_AM33XX is not set
# CONFIG_SOC_AM43XX is not set
# CONFIG_SOC_DRA7XX is not set
CONFIG_LOCALVERSION="-pandaboard"
# CONFIG_LOCALVERSION_AUTO is not set
# gzip: fast to decompress, no extra host tools (omap2plus uses LZMA)
CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_LZMA is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Boot path built in (no initramfs module juggling) -----------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_OMAP_HS=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OMAP=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_OMAP=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BLK_DEV_INITRD=y

# --- Alpine diskless: modloop (squashfs over loop) + overlay ------------------
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_OVERLAY_FS=m
CONFIG_EXT4_FS=y

# --- Ethernet: LAN9514 hub + SMSC95xx on EHCI --------------------------------
CONFIG_USB=y
# No OTG/gadget on the appliance; also lets NOP_USB_XCEIV be built in.
# CONFIG_USB_GADGET is not set
# CONFIG_USB_MUSB_HDRC is not set
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_OMAP=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_IPV6=y
CONFIG_IP_MULTICAST=y

# --- Firewall (restrict network audio ports to the LAN) ----------------------
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_REJECT=m

# --- Not needed on the appliance (also shortens the build) --------------------
# No Wi-Fi at all (the WL1271 is used for Bluetooth only)
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# DSP/IPU co-processors: no firmware available
# CONFIG_REMOTEPROC is not set
# No keypad, camera/TV/IR, or NAND on the Panda
# CONFIG_KEYBOARD_OMAP4 is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RC_CORE is not set
# CONFIG_MTD is not set

# --- Audio -------------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_HRTIMER=m
CONFIG_SND_SOC_TI_SDMA_PCM=m
CONFIG_SND_SOC_OMAP_MCPDM=m
CONFIG_SND_SOC_OMAP_DMIC=m
CONFIG_SND_SOC_OMAP_ABE_TWL6040=m
CONFIG_SND_SOC_TWL6040=m
CONFIG_TWL6040_CORE=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m
CONFIG_HIGH_RES_TIMERS=y

# --- Bluetooth: onboard WL1271 (UART2 serdev) + USB dongles -------------------
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_LL=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_UHID=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_ECB=y
CONFIG_KEY_DH_OPERATIONS=y

# --- Power / reliability -----------------------------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_WATCHDOG=y
CONFIG_OMAP_WATCHDOG=y
CONFIG_RTC_DRV_TWL4030=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# --- Firmware: Alpine ships linux-firmware zstd-compressed --------------------
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
