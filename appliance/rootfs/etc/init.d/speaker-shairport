#!/sbin/openrc-run
# AirPlay receiver (classic AirPlay 1): shairport-sync as user "speaker",
# playing into the system-wide PipeWire (ALSA "pipewire" PCM, pipewire-alsa).
# Config: /etc/shairport-sync.conf, generated by /etc/panda/setup.sh.
# Announces itself over avahi (mDNS) as $SPEAKER_NAME.

description="AirPlay receiver (shairport-sync, user speaker)"
supervisor=supervise-daemon
command=/usr/bin/shairport-sync
command_args="--configfile=/etc/shairport-sync.conf"
command_user="speaker:speaker"
directory=/var/lib/speaker
output_log=/var/log/speaker/shairport.log
error_log=/var/log/speaker/shairport.log
respawn_delay=5
respawn_max=0
supervise_daemon_args="--env XDG_RUNTIME_DIR=/run/speaker --env PIPEWIRE_RUNTIME_DIR=/run/speaker --env HOME=/var/lib/speaker"
# Realtime for its ALSA buffer-monitor thread (same limits as PipeWire).
rc_ulimit="-r 95 -e 40"

depend() {
	need net speaker-wireplumber avahi-daemon
}
